+	for (i = 0; i < CSR_REG_NUM; i++) {
+        tmpVal = get_npu_dbg_csr(core, csr_ofs[i]);
+		printk("%-15s<0x%x>\n", CSR_NAME[i], tmpVal);
+	}
+	printk("[H]Dump CSR END\n\n");
+	
+	return;
+}
+EXPORT_SYMBOL(host_dump_npu_csr);
+void npu_rv32_init(void)
+{
+	// NPU wifi offload reserve 16M block to save packet when boot, and get the address in here (after npu bring up)
+	//npu_wifi_offload_dbg_proc_create();
+	unsigned int isMailBoxSuccess = 0;
+	isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_NPU_BAND0_ONCPU(1, isNpuBand0OnCpu);
+	
+	if(isMailBoxSuccess != 1) printk("Error: NPU_WIFI_OFFLOAD Get NPU Band0 On CPU flag Fail!!!\n");
+
+	isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_PKT_BUF_ADDR(0,npu_wifi_offload_get_pkt_buf_addr());
+	if(isMailBoxSuccess != 1) printk("Error: NPU_WIFI_OFFLOAD Get packet buf address Fail!!!\n");	
+	/* when TDMA tx is used with DRAM, need these func
+#ifdef TCSUPPORT_NPU_WIFI_TDMA_OFFLOAD
+	printk("npu_wifi_offload_get_tdma_tx_pkt_buf_addr=%x\n", npu_wifi_offload_get_tdma_tx_pkt_buf_addr());
+	isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_TDMA_TX_PKT_BUF_ADDR(0, npu_wifi_offload_get_tdma_tx_pkt_buf_addr());
+	if(isMailBoxSuccess != 1) printk("Error: NPU_WIFI_OFFLOAD Get packet buf address Fail!!!\n");
+#endif
+	*/	
+	isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_TX_PKT_BUF_ADDR(0, npu_wifi_offload_get_tx_pkt_buf_addr());
+	if(isMailBoxSuccess != 1) printk("Error: NPU_WIFI_OFFLOAD Get packet buf address Fail!!!\n");
+	isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_IS_FORCE_TO_CPU(0, npu_wifi_offload_get_force_to_cpu_flag());
+	if(isMailBoxSuccess != 1) printk("Error: NPU_WIFI_OFFLOAD Get isForceToCpu flag Fail!!!\n");
+}
+char npu_stat;
+EXPORT_SYMBOL(npu_stat);
+#define NPU_PKT_BUF_SIZE (0x2c00000)
+#define NPU_TX_PKT_BUF_SIZE 0x3a00000
+#define NPU_BA_NODE_SIZE (0x200000)
+
+void arioha_arm_memblock_init_inline_hook(void)
+{
+	/***pkt buf addr****/
+	phys_addr_t npu_pkt_buf_phy_addr = 0;
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 55))
+	npu_pkt_buf_phy_addr = memblock_phys_alloc_range(NPU_PKT_BUF_SIZE, 64, 0x80000000, 0xbfffffff);
+#else
+	npu_pkt_buf_phy_addr = memblock_alloc(NPU_PKT_BUF_SIZE, 64);
+#endif	
+	if(npu_pkt_buf_phy_addr)
+	{
+		memblock_reserve(npu_pkt_buf_phy_addr, NPU_PKT_BUF_SIZE);
+		npu_wifi_offload_set_pkt_buf_addr(npu_pkt_buf_phy_addr);
+		printk("npu_pkt_buffer memblock_alloc:%llx,buf_size=%x\n\r", npu_pkt_buf_phy_addr, NPU_PKT_BUF_SIZE);
+	}
+	else
+	{
+		printk("\r\n npu_pkt_buffer memblock_alloc fail \n\r");
+	}
+	/*** tx pkt buff addr ***/
+	phys_addr_t npu_tx_pkt_buf_phy_addr = 0;
+	//printk("try alloc for tx pkt buf\n");
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 55))
+	npu_tx_pkt_buf_phy_addr = memblock_phys_alloc_range(NPU_TX_PKT_BUF_SIZE, 64, 0x80000000, 0xbfffffff);
+#else
+	npu_tx_pkt_buf_phy_addr = memblock_alloc(NPU_TX_PKT_BUF_SIZE, 4);
+#endif
+
+	if(npu_tx_pkt_buf_phy_addr)
+	{
+		memblock_reserve(npu_tx_pkt_buf_phy_addr, NPU_TX_PKT_BUF_SIZE);
+		npu_wifi_offload_set_tx_pkt_buf_addr(npu_tx_pkt_buf_phy_addr);
+		printk("npu_tx_pkt_buffer 7581 memblock_alloc:%llx, buf_size=%x\n\r", npu_tx_pkt_buf_phy_addr, NPU_TX_PKT_BUF_SIZE);
+	}
+	else
+	{
+		printk("\r\n npu_tx_pkt_buffer memblock_alloc fail \n\r");
+	}	
+	
+	/*** ba node addr ***/
+	phys_addr_t npu_ba_node_phy_addr = 0;
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 55))
+	npu_ba_node_phy_addr = memblock_phys_alloc_range(NPU_BA_NODE_SIZE, 64, 0x80000000, 0xbfffffff);
+#else
+	npu_ba_node_phy_addr = memblock_alloc(NPU_BA_NODE_SIZE, 64);
+#endif
+	if(npu_ba_node_phy_addr)
+	{
+		memblock_reserve(npu_ba_node_phy_addr, NPU_BA_NODE_SIZE);
+		npu_wifi_offload_set_ba_node_addr(npu_ba_node_phy_addr);
+		printk("npu_ba_node memblock_alloc:%llx,buf_size=%x\n\r", npu_ba_node_phy_addr, NPU_BA_NODE_SIZE);
+	}
+	else
+	{
+		printk("\r\n npu_ba_node memblock_alloc fail \n\r");
+	}
+}
+EXPORT_SYMBOL(arioha_arm_memblock_init_inline_hook);
+
+#endif
+#endif
