-        }
-    }
-
-    //spin_lock_bh(&mboxObj[mboxInfo->core_id].npuMboxLock);
-    //spin_lock_irqsave(&mboxObj[mboxInfo->core_id].npuMboxLock,flag);
-
-    #ifdef MBOX_DBG_ON
