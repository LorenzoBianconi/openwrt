-            break;
-        }
-    }
-    #ifdef MBOX_DBG_ON
-    printk("%s exit (res:%d, timeoutCnt:%d)\n", __func__, res, timeoutCnt);
-    #endif
-
-    //spin_unlock_bh(&mboxObj[mboxInfo->core_id].npuMboxLock);
-    spin_unlock_irqrestore(&mboxObj[mboxInfo->core_id].npuMboxLock,flag);
-    
-    return res;
