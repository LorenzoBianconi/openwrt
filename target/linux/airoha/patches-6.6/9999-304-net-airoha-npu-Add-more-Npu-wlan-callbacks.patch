-	npu_glb->ops.wifi_set_txrx_reg_addr = WIFI_MAIL_API_SET_WAIT_INODE_TXRX_REG_ADDR;
-	npu_glb->ops.wifi_set_pcie_port_type = WIFI_MAIL_API_SET_WAIT_PCIE_PORT_TYPE;
