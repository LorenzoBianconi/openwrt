+	npu_glb->ops.wlan_set_desc = airoha_npu_wlan_set_desc;
+	npu_glb->ops.wlan_set_tx_ring_pcie_addr =
+		airoha_npu_wlan_set_tx_ring_pcie_addr;
+	npu_glb->ops.wlan_get_rx_desc_base = airoha_npu_wlan_get_rx_desc_base;
+	npu_glb->ops.wlan_set_tx_buf_space_base =
+		airoha_npu_wlan_set_tx_buf_space_base;
+	npu_glb->ops.wlan_set_rx_ring_for_txdone =
