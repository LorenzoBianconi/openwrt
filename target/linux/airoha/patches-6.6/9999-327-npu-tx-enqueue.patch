+static int airoha_npu_wlan_tx_enqueue(struct airoha_npu *npu, int qid,
+				      struct sk_buff *skb, void *txwi,
+				      u16 txwi_len)
+{
+	struct airoha_npu_tx_dma_desc *desc;
+	struct airoha_npu_queue *q;
+	dma_addr_t dma_addr;
+	u32 tail;
+
+	if (qid >= ARRAY_SIZE(npu->q_tx))
+		return -EINVAL;
+
+	q = &npu->q_tx[qid];
+	/* FIXME: This must be moved in mt76 callback */
+	regmap_read(npu->regmap, REG_TX_CPU_IDX(qid + 2), &tail);
+	while (tail != q->tail) {
+		q->tx_desc[q->tail].ctrl &= ~NPU_TX_DMA_DESC_DONE_MASK;
+		q->tail = (q->tail + 1) % q->ndesc;
+		q->queued--;
+	}
+
+	/* FIXME: Take into account unlinear skbs */
+	if (skb_linearize(skb))
+		return -EINVAL;
+
+	if (q->queued + 1 > q->ndesc)
+		return -EBUSY;
+
+#if 0
+	struct port_info wifi_info;
+	unsigned char bss_idx, is_tcp, qos_tid;
+	unsigned int wcidx;	
+	npu_hif_v2_info npu_txp_info;
+	__le32 *_txd = (__le32 *)vnd;
+	unsigned int token;
+	
+	memset(&wifi_info, 0 , sizeof(struct port_info));
+	
+	wifi_info.tsid = 0x7F;
+	wifi_info.nbq = band;
+	bss_idx = _txd[9] & 0xff; //txp[9] bss_id[7:0]
+	wcidx = (_txd[9] >> 8) & 0xffff; //txp[9] wtbl_idx[23:8]
+		
+	if (bss_idx > 0x7f) {
+		  printk("npu_wifi bss index is error\n");
+	}
+
+	qos_tid = skb->priority & IEEE80211_QOS_CTL_TID_MASK;
+	token = (_txd[8] >> 16) & 0xffff;
+
+	npu_txp_info._detail.ring_num = band;
+	npu_txp_info._detail.qos_tid	=	qos_tid;
+
+	wifi_info.udf = (bss_idx & 0x7f) | (is_tcp << 7);		
+	wifi_info.stag = ((wcidx & 0x7ff) | ((npu_txp_info.ctrl_word & 0x1f) << 11));
+	airoha_ppe_foe_flow_update_wifi_npu_offload(glb_eth->ppe, skb, &wifi_info);
+
+#endif
+	desc = &q->tx_desc[q->head];
+	txwi_len = min_t(u16, txwi_len, sizeof(desc->txwi));
+	memcpy(desc->txwi, txwi, txwi_len);
+	/* FIXME: DMA map into mt76 driver */
+	dma_addr = dma_map_single(npu->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(npu->dev, dma_addr))
+		return -ENOMEM;
+
+	desc->addr = dma_addr;
+	/* FIXME: Take into account unlinear skbs */
+	desc->ctrl = FIELD_PREP(NPU_TX_DMA_DESC_VEND_LEN_MASK, txwi_len) |
+		     FIELD_PREP(NPU_TX_DMA_DESC_LEN_MASK, skb->len) |
+		     NPU_TX_DMA_DESC_DONE_MASK;
+
+	q->head = (q->head + 1) % q->ndesc;
+	q->queued++;
+
+	return 0;
+}
