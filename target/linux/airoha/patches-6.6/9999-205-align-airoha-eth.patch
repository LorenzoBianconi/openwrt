+#define CR_FE_PPE_PHY_RANGE		(0x4000)
+#define CR_FE_PPE_PHY_END		(CR_FE_PPE_PHY_BASE + CR_FE_PPE_PHY_RANGE)
+#define CR_FE_PPE_PHY_BASE		(0x1fb50000)
+u32 get_fe_ppe_data(u32 reg)
