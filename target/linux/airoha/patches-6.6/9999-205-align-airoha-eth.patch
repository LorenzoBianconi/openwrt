+static inline int channel_is_recorded(unsigned char channel, int num, unsigned char *channelPtr)
+{
+	int i = 0 ;
+	unsigned char * tmpPtr = channelPtr;
+	for(i = 0; i < num; i++){
+		if(channel == *tmpPtr){
+			/*This channel id has been recorded already.*/
+			return 0;
+		}
+		tmpPtr ++;
+	}
+	return -1;
+}
