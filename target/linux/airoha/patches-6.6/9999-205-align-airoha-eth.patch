+static int __inline__ generalChecConfigDone(struct airoha_qdma *base, uint reg, uint doneBit)
+{
+	int RETRY = 3 ;
+	volatile uint regValue = 0 ;
+	
+	while(RETRY--) {
+		//regValue = IO_GREG(reg) ;
+		regValue = airoha_qdma_rr(base, reg);
+		
+		if(regValue & doneBit) {
+			break ;
+		}
+		mdelay(1) ;
+	}
+	if(RETRY < 0) {
+		return -ETIME ;
+	}
+
+	return 0;
+}
