+	else if((enNo) == 3)
+	{
+		return (0x0740 + ((intNo-1)<<5));
+	}
+	else if((enNo) == 4)
+	{
+		return (0x0744 + ((intNo-1)<<5));
+	}
+	else
+	{
+		return (0x0750 + ((intNo-1)<<5));
+	}
+	return 0;
+}
