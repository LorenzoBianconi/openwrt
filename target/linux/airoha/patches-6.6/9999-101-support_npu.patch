+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 55))
+	npu_ba_node_phy_addr = memblock_phys_alloc_range(NPU_BA_NODE_SIZE, 64, 0x80000000, 0xbfffffff);
+#else
+	npu_ba_node_phy_addr = memblock_alloc(NPU_BA_NODE_SIZE, 64);
