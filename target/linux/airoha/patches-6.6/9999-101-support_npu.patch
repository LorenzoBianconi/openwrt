+static irqreturn_t npuMbox2host_isr(int irq, void *dev_id)
+{
+
+    if (mbox2host_cb) {
+        mbox2host_cb();
+    }
+    else {
+    	/* clear mbox8 interrupt */
+        set_npu_reg_data(CR_MBOX_INTR_STATUS, 1<<MBOX2HOST_IDX);
+
+    	tasklet_schedule(&mbox_tasklet);
+    }
+	return IRQ_HANDLED;
+}
