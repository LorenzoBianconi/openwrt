+	size_t len = count, buf_length = 0;
+	loff_t pos = *ppos;
+	unsigned long ret = 0;
+	ssize_t retval = 0;
+	
+	/* use memory size for data stream or use length of string buffer */
+	buf_length = snprintf(user_buf, sizeof(user_buf), "%d\n", reTryTimes);
+	
+	/* valid check */
+	if ( pos >= buf_length )
+		return 0;
+	if ( len >= buf_length )
+		len = buf_length;
+	if ( pos + len > buf_length )
+		len = buf_length - pos;
+	
+	/* ret contains the amount of chars wasn't successfully written to buf */
+	ret = copy_to_user(buf, user_buf + pos, len);
+	
+	*ppos += len;
+	retval = len - ret;
+
+	return retval;
+}
+#else
+static int retry_times_proc_read(char *buf, char **start, off_t offset, int count, int *eof, void *data)
+{
+	int len = 0;
+
+	len += sprintf(buf +len, "%d\n", reTryTimes);
+	if(len > PAGE_SIZE)
+	{
+		return -ENOBUFS;
+	}
+	return len;
+}
+#endif
