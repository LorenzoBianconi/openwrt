+void hostadpt_free_interrupt(u32 irq_num)
+{
+	if(irq_num > 5)
+	{
+		HOSTADPT_MSG(DBG_ERR, "irq num error, valid irq num : 0 - 5 \n");
+		return ;
+	}
+	free_irq(get_npu_irq(irq_num), NULL);
+	return ;
