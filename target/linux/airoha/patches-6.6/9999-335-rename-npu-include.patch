+		u32 (*wlan_get_irq)(struct airoha_npu *npu, int q);
+		void (*wlan_irq_enable)(struct airoha_npu *npu, int q);
+		void (*wlan_irq_disable)(struct airoha_npu *npu, int q);
+	} ops;
+#endif
