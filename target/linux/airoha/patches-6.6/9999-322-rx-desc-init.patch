+static int airoha_npu_fill_rx_queue(struct airoha_npu *npu,
+				    struct airoha_npu_queue *q)
+{
+	enum dma_data_direction dir = page_pool_get_dma_dir(q->page_pool);
+	struct airoha_npu_rx_dma_desc *desc = q->desc;
+	struct airoha_npu_queue_entry *e = q->entry;
+	int nframes = 0;
+
+	while (q->queued < q->ndesc - 1) {
+		struct page *page;
+		int offset;
+
+		page = page_pool_dev_alloc_frag(q->page_pool, &offset,
+						q->buf_size);
+		if (!page)
+			return -ENOMEM;
+
+		e[q->head].buf = page_address(page) + offset;
+		e[q->head].dma_addr = page_pool_get_dma_addr(page) + offset;
+		e[q->head].dma_len = SKB_WITH_OVERHEAD(q->buf_size);
+
+		memset(&desc[q->head], 0, sizeof(*desc));
+		desc[q->head].addr = e[q->head].dma_addr;
+
+		dma_sync_single_for_device(npu->dev, e[q->head].dma_addr,
+					   e[q->head].dma_len, dir);
+
+		q->head = (q->head + 1) % q->ndesc;
+		q->queued++;
+	}
+
+	return nframes;
+}
+
+static struct sk_buff *airoha_npu_rx_dequeue(struct airoha_npu *npu, int qid)
+{
+	struct airoha_npu_queue *q = &npu->q_rx[qid];
+	struct airoha_npu_rx_dma_desc *desc = q->desc;
+	struct airoha_npu_queue_entry *e = q->entry;
+	struct sk_buff *skb;
+	int len;
+
+	if (!FIELD_GET(NPU_RX_DMA_DESC_DONE_MASK, desc[q->tail].ctrl))
+		return NULL;
+
+	dma_sync_single_for_cpu(npu->dev, desc[q->tail].addr,
+				SKB_WITH_OVERHEAD(q->buf_size),
+				page_pool_get_dma_dir(q->page_pool));
+
+	skb = build_skb(e[q->tail].buf, q->buf_size);
+	if (!skb)
+		return NULL;
+
+	len = FIELD_GET(NPU_RX_DMA_DESC_CUR_LEN_MASK, desc[q->tail].ctrl);
+	__skb_put(skb, len);
+	skb_mark_for_recycle(skb);
+	skb_reset_mac_header(skb);
+
+	airoha_npu_fill_rx_queue(npu, q);
+
+	q->tail = (q->tail + 1) % q->ndesc;
+	q->queued--;
+
+	regmap_write(npu->regmap, REG_RX_CPU_IDX(qid), q->tail);
+
+	/* FIXME */
+	//npu_get_entry_bind(skb, pHostadptRX->pkt_info.foe_number, pHostadptRX->pkt_info.crsn);
+
+	return skb;
+}
