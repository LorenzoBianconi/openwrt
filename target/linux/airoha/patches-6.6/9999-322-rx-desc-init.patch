+static void airoha_npu_cleanup_rx_queue(struct airoha_npu *npu,
+					struct airoha_npu_queue *q)
+{
+	while (q->queued) {
+		struct airoha_queue_entry *e = q->entry;
+
+		dma_sync_single_for_cpu(npu->dev, e[q->tail].dma_addr,
+					e[q->tail].dma_len,
+					page_pool_get_dma_dir(q->page_pool));
+		page_pool_put_full_page(q->page_pool,
+					virt_to_head_page(e[q->tail].buf),
+					false);
+		q->tail = (q->tail + 1) % q->ndesc;
+		q->queued--;
+	}
+}
