From 87daf5fd8a8336d70b44a9d97772efa880036f0c Mon Sep 17 00:00:00 2001
Message-ID: <87daf5fd8a8336d70b44a9d97772efa880036f0c.1740050334.git.lorenzo@kernel.org>
From: Lorenzo Bianconi <lorenzo@kernel.org>
Date: Thu, 20 Feb 2025 12:18:51 +0100
Subject: [PATCH net-next] net: airoha: take into account all possible GDM
 combinations in airhoa_is_lan_gdm_port()

Signed-off-by: Lorenzo Bianconi <lorenzo@kernel.org>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 35 ++++++++++++++++++------
 1 file changed, 26 insertions(+), 9 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -69,11 +69,19 @@ static void airoha_qdma_irq_disable(stru
 
 static bool airhoa_is_lan_gdm_port(struct airoha_gdm_port *port)
 {
+	struct airoha_eth *eth = port->qdma->eth;
+
 	/* GDM1 port on EN7581 SoC is connected to the lan dsa switch.
 	 * GDM{2,3,4} can be used as wan port connected to an external
 	 * phy module.
 	 */
-	return port->id == 1;
+	if (port->id == 1)
+		return true; /* GDM1 is always used as LAN port */
+
+	if (port->id == 2 || eth->ports[0])
+		return false; /* GDM2 is always used as WAN port */
+
+	return !!eth->ports[1];
 }
 
 static void airoha_set_macaddr(struct airoha_gdm_port *port, const u8 *addr)
@@ -2664,11 +2672,7 @@ static int airoha_alloc_gdm_port(struct
 	if (err)
 		return err;
 
-	err = airoha_register_port_debugfs(port);
-	if (err)
-		return err;
-
-	return register_netdev(dev);
+	return airoha_register_port_debugfs(port);
 }
 
 static int airoha_probe(struct platform_device *pdev)
@@ -2750,6 +2754,17 @@ static int airoha_probe(struct platform_
 		}
 	}
 
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+
+		err = register_netdev(port->dev);
+		if (err)
+			goto error_napi_stop;
+	}
+
 	return 0;
 
 error_napi_stop:
@@ -2763,10 +2778,12 @@ error_hw_cleanup:
 	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
 		struct airoha_gdm_port *port = eth->ports[i];
 
-		if (port && port->dev->reg_state == NETREG_REGISTERED) {
-			airoha_metadata_dst_free(port);
+		if (!port)
+			continue;
+
+		airoha_metadata_dst_free(port);
+		if (port->dev->reg_state == NETREG_REGISTERED)
 			unregister_netdev(port->dev);
-		}
 	}
 	free_netdev(eth->napi_dev);
 	platform_set_drvdata(pdev, NULL);
