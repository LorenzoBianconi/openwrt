+void get_npu_rxd(struct mt7996_dev *dev,struct pci_dev *pdev)
+{	
+	npu_info_t get_RingBase;
+	int isMailBoxSuccess=0;
+	unsigned char band_idx = 0;	
+	dma_addr_t npu_alloc_pa;
+	struct airoha_npu *npu = airoha_npu_get(dev->mt76.dev);
+	band_idx = slot_id;
+	
+
+	/* npu rx rro ring*/
+	//isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(0, &get_RingBase);
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(0, &get_RingBase);
+	if(isMailBoxSuccess != 1) 
+		printk("Error: NPU_WIFI_OFFLOAD get ring0 base fail\n");
+	npu_alloc_pa=(NDIS_PHYSICAL_ADDRESS)get_RingBase.info;
+	writel(npu_alloc_pa,&dev->mt76.q_rx[MT_RXQ_RRO_BAND0].regs->desc_base);
+	
+	//isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(1, &get_RingBase);
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(1, &get_RingBase);
+	if(isMailBoxSuccess != 1) 
+		printk("Error: NPU_WIFI_OFFLOAD get ring1 base fail\n");
+	npu_alloc_pa=(NDIS_PHYSICAL_ADDRESS)get_RingBase.info;
+	writel(npu_alloc_pa,&dev->mt76.q_rx[MT_RXQ_RRO_BAND1].regs->desc_base);		
+
+	/* MSDU PG ring */
+	//isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(10, &get_RingBase);
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(10, &get_RingBase);
+	if(isMailBoxSuccess != 1) 
+		printk("Error: NPU_WIFI_OFFLOAD get MSDU PG base fail\n");
+	npu_alloc_pa=(NDIS_PHYSICAL_ADDRESS)get_RingBase.info;
+	writel(npu_alloc_pa,&dev->mt76.q_rx[MT_RXQ_MSDU_PAGE_BAND0].regs->desc_base);		
+	
+	/* ind_cmd ring */
+	//isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(8, &get_RingBase);
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_GET_WAIT_RXDESC_BASE(8, &get_RingBase);
+	if(isMailBoxSuccess != 1) 
+		printk("Error: NPU_WIFI_OFFLOAD get ind_cmd ring base fail\n");
+	npu_alloc_pa=(NDIS_PHYSICAL_ADDRESS)get_RingBase.info;
+	writel(npu_alloc_pa,&dev->mt76.q_rx[MT_RXQ_RRO_IND].regs->desc_base);	
+	
+}
