+		isMailBoxSuccess = npu->ops.WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE((band_idx+10), txbuf_alloc_pa_swq);
+		if(isMailBoxSuccess != 1){
+			printk("Error: WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE fail\n");
+		}
+	}
+	
+}
+EXPORT_SYMBOL_GPL(get_npu_txd);
+
+char npu_mt76_token_release(struct mt76_dev *dev, unsigned int token, struct mt76_wcid *wcid, struct ieee80211_sta *sta)
+{	
+	struct mt76_txwi_cache *txwi_t;	
+	struct sk_buff *skb, *tmp;
+	LIST_HEAD(free_list);
+	
+	spin_lock_bh(&dev->token_lock);
+	
+	txwi_t = idr_remove(&dev->token, token);
+	
+	if (txwi_t) {
+		struct mt76_phy *phy = mt76_dev_phy(dev, txwi_t->phy_idx);
+		
+		dev->token_count--;
+		phy->tokens--;
+	}
+	
+	spin_unlock_bh(&dev->token_lock);
+	if (txwi_t) {
+		dev->drv->npu_txwi_free(dev, txwi_t, sta, wcid, &free_list);		
+		txwi_t->jiffies = 0;
+	}
+	
+	mt76_worker_schedule(&dev->tx_worker);
+	
+	list_for_each_entry_safe(skb, tmp, &free_list, list) {
+		skb_list_del_init(skb);
+		napi_consume_skb(skb, 1);
+	}
+
+	return 0;
+}
+
+void npu_mt76_dma_tx_queue_skb(struct mt76_phy *phy, struct mt76_dev *dev, struct mt76_txwi_cache *t, 
+	struct sk_buff *skb, void *txwi_ptr, struct mt76_wcid *wcid, struct ieee80211_sta *sta)
+{
+	struct sk_buff *n_skb = NULL;
+	unsigned short vnd_len;
+	__le32 *_txd;
+	unsigned char hostadpt_ring_num = 0, band_idx;
+	unsigned int token;
+	int ret = 0;//0 means to free skb
+	unsigned char txp_temp[MT_TXD_SIZE+HIF_TXP_SIZE];
+	_txd = (__le32 *)txwi_ptr;
+
+	n_skb = skb_clone(skb, GFP_ATOMIC);	
+
+	if (!n_skb) {
+		dev_kfree_skb(skb);
+		return;
+	}
+	
+	if(phy == dev->phys[1])		
+		band_idx = MT_BAND1;
+	else
+		band_idx = MT_BAND0;
+	
+	hostadpt_ring_num = band_idx;
+	token = (_txd[8] >> 16) & 0xffff;
+#if 0
+	if (ra_sw_nat_hook_tx != NULL)
+	{
+		memset(&wifi_info, 0 , sizeof(struct port_info));
+#if defined(TCSUPPORT_CPU_EN7580)
+		wifi_info.tsid = 0x7F;
+		wifi_info.nbq = 1;
+#endif
+		bss_idx = _txd[9] & 0xff; //txp[9] bss_id[7:0]
+		wcidx = (_txd[9] >> 8) & 0xffff; //txp[9] wtbl_idx[23:8]
+		//is_tcp = GET_PACKET_TCP(skb) ? 1 : 0;
+			
+		if (bss_idx > 0x7f) {
+			  printk("npu_mt76_dma_tx_queue_skb bss index is error\n");
+		}
+
+		qos_tid = n_skb->priority & IEEE80211_QOS_CTL_TID_MASK;
+
+		npu_txp_info._detail.ring_num = hostadpt_ring_num;
+		npu_txp_info._detail.qos_tid	=	qos_tid;
+
+		wifi_info.magic = FOE_MAGIC_WLAN;
+		wifi_info.udf = (bss_idx & 0x7f) | (is_tcp << 7);		
+		wifi_info.stag = ((wcidx & 0x7ff) | ((npu_txp_info.ctrl_word & 0x1f) << 11));
+
+#ifdef TCSUPPORT_MT7510_FE
+		if (ra_sw_nat_hook_tx(n_skb, &wifi_info, wifi_info.magic) == 0)
+#else
+		if (ra_sw_nat_hook_tx(n_skb, 1) == 0)
+#endif
+		{
+			if(npu_mt76_token_release(dev, token, wcid, sta)){
+				printk("npu_mt76_token_release fail\n");
+			}
+			dev_kfree_skb(n_skb);
+			return;
+		}
+	}
+#endif
+	vnd_len = MT_TXD_SIZE + HIF_TXP_SIZE;
+	
+	memcpy(txp_temp,txwi_ptr,vnd_len);
+		
+	if(toHostadptPktHandle_hook && n_skb){
+		ret = toHostadptPktHandle_hook(hostadpt_ring_num, n_skb, txp_temp, vnd_len);
+	}
+	
+	//handle token/txwi free
+	if(ret == -2)  //tx hook
+		dev_kfree_skb(n_skb);
+	
+	if(npu_mt76_token_release(dev, token, wcid, sta)){
+		printk("npu_mt76_token_release fail\n");
+	}
+	
+	return;
+}
+
+EXPORT_SYMBOL_GPL(npu_mt76_dma_tx_queue_skb);
+
+void npu_set_rx_event(struct mt7996_dev *dev,struct pci_dev *pdev)
+{
+	unsigned long int pcie_pa = 0;
+	int isMailBoxSuccess = 0;
+	unsigned char band_idx = 0;
+	struct airoha_npu *npu = airoha_npu_get(dev->mt76.dev);
+	
+	//isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_RX_RING_FOR_TXDONE_HW_BASE(band_idx, dev->mt76.q_rx[MT_RXQ_MAIN_WA].desc_dma); // npu  : tx_done_ring0_addr_uncache
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_SET_WAIT_RX_RING_FOR_TXDONE_HW_BASE(band_idx, dev->mt76.q_rx[MT_RXQ_MAIN_WA].desc_dma);
+	//isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_DESC((band_idx + 10), MT7996_RX_MCU_RING_SIZE); //npu : g_tx_done_ring0_size
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_SET_WAIT_DESC((band_idx + 10), MT7996_RX_MCU_RING_SIZE);
+	if(isMailBoxSuccess != 1){
+		printk( "%s() Error: WIFI_MAIL_API_SET_WAIT_DESC fail\n", __func__);
+	}
+	
+	pcie_pa = pci_resource_start(pdev, 0); //get pcie phy addr
+	//isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_PCIE_ADDR((band_idx + 10), (pcie_pa + MT_RXQ_RING_BASE(MT_RXQ_MAIN_WA) + 0x20));//npu : TxDone_ring0_pcie_base
+	isMailBoxSuccess = npu->ops.WIFI_MAIL_API_SET_WAIT_PCIE_ADDR((band_idx + 10), (pcie_pa + MT_RXQ_RING_BASE(MT_RXQ_MAIN_WA) + 0x20));
+	return;
+}
+EXPORT_SYMBOL_GPL(npu_set_rx_event);
+
+int npu_enable(void)
+{
+	return npu_enable_chk;
+}
+void set_npu_enable(int enable)
+{
+	npu_enable_chk = enable;
+}
+EXPORT_SYMBOL_GPL(npu_enable);
+EXPORT_SYMBOL_GPL(set_npu_enable);
