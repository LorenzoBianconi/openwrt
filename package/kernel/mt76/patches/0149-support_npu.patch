+void get_npu_txd(struct mt7996_dev *dev,struct pci_dev *pdev)
+{
+	npu_info_t get_RingBase;
+	int isMailBoxSuccess=0;
+	unsigned char band_idx = 0;
+	struct mt76_dev *mdev = &dev->mt76;
+	
+	void *npu_alloc_va = NULL;
+	dma_addr_t npu_alloc_pa;
+	
+	void *txbuf_alloc_va_sp = NULL;
+	dma_addr_t txbuf_alloc_pa_sp;	
+	void *txbuf_alloc_va_fp = NULL;
+	dma_addr_t txbuf_alloc_pa_fp;
+	void *txbuf_alloc_va_swq = NULL;
+	dma_addr_t txbuf_alloc_pa_swq;
+	
+	for(band_idx = 0; band_idx < 2; band_idx++){
+		if(band_idx == 0){
+			isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE((band_idx + 5), &get_RingBase);
+			npu_alloc_pa = (dma_addr_t)get_RingBase.info;
+			npu_alloc_va = ioremap((phys_addr_t)get_RingBase.info,4);					
+			writel(npu_alloc_pa, &dev->mt76.phy.q_tx[0]->regs->desc_base);
+		}
+		else{
+			isMailBoxSuccess = WIFI_MAIL_API_GET_WAIT_RXDESC_BASE((band_idx + 5), &get_RingBase);
+			npu_alloc_pa = (dma_addr_t)get_RingBase.info;
+			npu_alloc_va = ioremap((phys_addr_t)get_RingBase.info,4);					
+			writel(npu_alloc_pa, &dev->mt76.phys[1]->q_tx[0]->regs->desc_base);
+		}
+
+		txbuf_alloc_va_sp = dmam_alloc_coherent(mdev->dma_dev, MT7996_TX_RING_SIZE * 256,
+				      &txbuf_alloc_pa_sp, GFP_KERNEL);
+		if (!txbuf_alloc_va_sp) {
+			printk("%s can't alloc memory !\n", __func__);
+		}
+
+		txbuf_alloc_va_fp = dmam_alloc_coherent(mdev->dma_dev, MT7996_TX_RING_SIZE * 256,
+				      &txbuf_alloc_pa_fp, GFP_KERNEL);
+		if (!txbuf_alloc_va_fp) {
+			printk("%s can't alloc memory !\n", __func__);
+		}
+
+		//1024 is TX_PKT_INFO_MAX_NUM in npu_specific_define_eagle.h
+		txbuf_alloc_va_swq = dmam_alloc_coherent(mdev->dma_dev, 1024 * 256,
+				      &txbuf_alloc_pa_swq, GFP_KERNEL);
+		if (!txbuf_alloc_va_swq) {
+			printk("%s can't alloc memory !\n", __func__);
+		}
+		
+		isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE(band_idx, txbuf_alloc_pa_sp);
+		if(isMailBoxSuccess != 1){
+			printk("Error: WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE fail\n");
+		}
+		
+		isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE((band_idx+5), txbuf_alloc_pa_fp);
+		if(isMailBoxSuccess != 1){
+			printk("Error: WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE fail\n");
+		}
+		
+		isMailBoxSuccess = WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE((band_idx+10), txbuf_alloc_pa_swq);
+		if(isMailBoxSuccess != 1){
+			printk("Error: WIFI_MAIL_API_SET_WAIT_TX_BUF_SPACE_BASE fail\n");
+		}
+	}
+	
+}
+EXPORT_SYMBOL_GPL(get_npu_txd);
