+static int mt7996_npu_set_pcie_addr(struct mt7996_dev *dev,
+				     struct airoha_npu *npu,
+				     struct pci_dev *pdev)
+{
+	int err;
+	u32 hif1_ofs = 0;
+	
+	phys_addr_t paddr = pci_resource_start(pdev, 0);
+	u32 band_idx = 0;
+	
+	if (dev->hif2)
+		hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);	
+	
+	/* npu rx rro ring*/
+	/*R8   -- refill ring0 5g+6g*/
+	err = airoha_npu_wlan_send_msg(npu, band_idx, 
+									WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+									paddr + MT_RXQ_RING_BASE(MT_RXQ_RRO_BAND0) + 0x80, GFP_ATOMIC); 
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting npu wlan PCIe desc addr\n");
+		return err;
+	}
+			
+	/*R6  -- refill ring1 2g*/
+	err = airoha_npu_wlan_send_msg(npu, band_idx + 2, 
+									WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+									paddr + MT_RXQ_RING_BASE(MT_RXQ_RRO_BAND2) + 0x60 + hif1_ofs, GFP_ATOMIC);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting npu wlan PCIe desc addr\n");
+		return err;
+	}
+	
+	return err;
+}
+
 static int mt7996_npu_init_tx_done(struct mt7996_dev *dev, struct airoha_npu *npu)
 {
 	int err;
 
+	if(is_mt7996(&dev->mt76)){
+		/* rro ring set cpu idx */
+		err = airoha_npu_wlan_send_msg(npu, 15, 
+										WLAN_FUNC_SET_WAIT_PCIE_ADDR, 0, GFP_ATOMIC);
+		if (err) {
+			dev_warn(dev->mt76.dev,
+				 "failed setting npu wlan PCIe desc addr 15\n");
+			return err;
+		}
+	}
+	
 	err = airoha_npu_wlan_send_msg(npu, 2,
 				       WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR, 0,
 				       GFP_ATOMIC);
@@ -827,6 +854,12 @@
 	if (err)
 			goto out;
 
+	if(is_mt7996(&dev->mt76)){
+		err = mt7996_npu_set_pcie_addr(dev, npu, pdev);	
+		if (err)
+			goto out;
+	}
+
 	err = mt7996_npu_init_tx_done(dev, npu);
 	if (err)
 		goto out;
