+void print_npu_wifi_offload_dbg_counter(struct mt7996_dev *dev , unsigned short int band)
+{
+    if(counter_base[2] == 0)
+    {
+        npu_wifi_offload_get_dbg_counter_address(dev);
+    }
+    show_wifi_offload_counter(band);   
+    return;
+}
