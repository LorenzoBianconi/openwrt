+		if(jiffies_to_msecs(jiffies - txwi->jiffies) < 20000)
+			continue;
+		txwi_tmp = mt76_token_release_npu(dev, msdu_id, &wake);
+		if (!txwi_tmp)
+			continue;
+		mt76_connac_txp_skb_unmap(dev, txwi_tmp);
+		if(txwi_tmp->skb)
+			napi_consume_skb(txwi_tmp->skb, 1);	
+		txwi_tmp->skb = NULL;
+		mt76_put_txwi(dev, txwi_tmp);
+		txwi_tmp->jiffies = 0;
+	}	
+}
